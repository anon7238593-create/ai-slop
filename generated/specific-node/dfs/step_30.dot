graph traversal {
  graph [layout=dot, rankdir=TB, bgcolor="#FFFFFF", pad="0.35", nodesep="0.65", ranksep="0.8", fontname="Arial"];
  node [shape=circle, style="filled", fontname="Arial Bold", fontsize=18, width=0.72, fixedsize=true, penwidth=2.4];
  edge [color="#94A3B8", penwidth=2.0];
  label=<<B>DFS Traversal</B><BR/><FONT POINT-SIZE="16">Step 30: Process node N</FONT>>; labelloc="t"; fontsize=26; fontname="Arial"; fontcolor="#0F172A";
  subgraph cluster_legend { label="Legend"; color="#CBD5E1"; penwidth=1.2; style="rounded"; fontsize=14; fontname="Arial Bold";
    key_unseen [label="Unseen", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", fontsize=12, width=0.82];
    key_frontier [label="Discovered", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", fontsize=12, width=0.95];
    key_current [label="Processing", fillcolor="#FFEDD5", color="#EA580C", fontcolor="#9A3412", fontsize=12, width=1.05];
    key_done [label="Complete", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", fontsize=12, width=0.92];
    { rank=same; key_unseen; key_frontier; key_current; key_done; }
  }
  A [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  B [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  C [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  D [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  E [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  F [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  G [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  H [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  I [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  J [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  K [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  L [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  M [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  N [fillcolor="#FFEDD5", color="#EA580C", fontcolor="#9A3412"];
  O [fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];
  A -- B [color="#7C3AED", penwidth=3.8];
  A -- C [color="#7C3AED", penwidth=3.8];
  A -- E [color="#7C3AED", penwidth=3.8];
  A -- F [color="#7C3AED", penwidth=3.8];
  A -- H;
  A -- J [color="#7C3AED", penwidth=3.8];
  A -- L [color="#7C3AED", penwidth=3.8];
  A -- M [color="#7C3AED", penwidth=3.8];
  B -- C;
  B -- J;
  B -- K [color="#7C3AED", penwidth=3.8];
  B -- L;
  C -- D;
  C -- F;
  C -- J;
  C -- K;
  C -- O;
  D -- G;
  D -- J;
  D -- K [color="#7C3AED", penwidth=3.8];
  D -- O [color="#7C3AED", penwidth=3.8];
  E -- G [color="#7C3AED", penwidth=3.8];
  E -- H [color="#7C3AED", penwidth=3.8];
  E -- I [color="#7C3AED", penwidth=3.8];
  E -- N [color="#7C3AED", penwidth=3.8];
  F -- H;
  F -- I;
  F -- J;
  F -- K;
  F -- N;
  F -- O;
  G -- I;
  G -- J;
  G -- M;
  G -- N;
  G -- O;
  H -- O;
  J -- K;
  K -- N;
  L -- M;
  M -- N;
  status [shape=plain, fixedsize=false, width=0, height=0, margin=0, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="7" BGCOLOR="#F1F5F9">
      <TR><TD ALIGN="LEFT"><B>Stack (top at right):</B> (empty)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>Visited:</B> A, B, C, D, E, F, G, H, I, J, K, L, M, O</TD></TR>
    </TABLE>
  >];
}
