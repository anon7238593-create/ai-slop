graph traversal {
  graph [layout=dot, rankdir=TB, bgcolor="#FFFFFF", pad="0.35", nodesep="0.65", ranksep="0.8", fontname="Arial"];
  node [shape=circle, style="filled", fontname="Arial Bold", fontsize=18, width=0.72, fixedsize=true, penwidth=2.4];
  edge [color="#94A3B8", penwidth=2.0];
  label=<<B>BFS Traversal</B><BR/><FONT POINT-SIZE="16">Step 2: Process node A</FONT>>; labelloc="t"; fontsize=26; fontname="Arial"; fontcolor="#0F172A";
  subgraph cluster_legend { label="Legend"; color="#CBD5E1"; penwidth=1.2; style="rounded"; fontsize=14; fontname="Arial Bold";
    key_unseen [label="Unseen", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", fontsize=12, width=0.82];
    key_frontier [label="Discovered", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", fontsize=12, width=0.95];
    key_current [label="Processing", fillcolor="#FFEDD5", color="#EA580C", fontcolor="#9A3412", fontsize=12, width=1.05];
    key_done [label="Complete", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", fontsize=12, width=0.92];
    { rank=same; key_unseen; key_frontier; key_current; key_done; }
  }
  A [label="A", fillcolor="#FFEDD5", color="#EA580C", fontcolor="#9A3412", peripheries=1, penwidth=2.4];
  B [label="B", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  C [label="C", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  D [label="D", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  E [label="E", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  F [label="F", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  G [label="G", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  H [label="H", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  I [label="I", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  J [label="J", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  K [label="K\n(TARGET)", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=2, penwidth=3.2, fontsize=11, width=0.85, height=0.85];
  L [label="L", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  M [label="M", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  N [label="N", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  O [label="O", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  A -- B;
  A -- C;
  A -- D;
  A -- I;
  A -- M;
  B -- D;
  B -- E;
  C -- G;
  C -- H;
  C -- N;
  C -- O;
  D -- G;
  D -- K;
  D -- M;
  D -- N;
  E -- F;
  E -- H;
  E -- I;
  E -- K;
  F -- J;
  F -- L;
  H -- N;
  H -- O;
  L -- M;
  status [shape=plain, fixedsize=false, width=0, height=0, margin=0, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="7" BGCOLOR="#F1F5F9">
      <TR><TD ALIGN="LEFT"><B>Queue:</B> (empty)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>Visited:</B> (none)</TD></TR>
    </TABLE>
  >];
}
