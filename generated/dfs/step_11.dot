graph traversal {
  graph [layout=dot, rankdir=TB, bgcolor="#FFFFFF", pad="0.35", nodesep="0.65", ranksep="0.8", fontname="Arial"];
  node [shape=circle, style="filled", fontname="Arial Bold", fontsize=18, width=0.72, fixedsize=true, penwidth=2.4];
  edge [color="#94A3B8", penwidth=2.0];
  label=<<B>DFS Traversal</B><BR/><FONT POINT-SIZE="16">Step 11: No new neighbors from I</FONT>>; labelloc="t"; fontsize=26; fontname="Arial"; fontcolor="#0F172A";
  subgraph cluster_legend { label="Legend"; color="#CBD5E1"; penwidth=1.2; style="rounded"; fontsize=14; fontname="Arial Bold";
    key_unseen [label="Unseen", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", fontsize=12, width=0.82];
    key_frontier [label="Discovered", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", fontsize=12, width=0.95];
    key_current [label="Processing", fillcolor="#FFEDD5", color="#EA580C", fontcolor="#9A3412", fontsize=12, width=1.05];
    key_done [label="Complete", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", fontsize=12, width=0.92];
    { rank=same; key_unseen; key_frontier; key_current; key_done; }
  }
  A [label="A", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", peripheries=1, penwidth=2.4];
  B [label="B", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", peripheries=1, penwidth=2.4];
  C [label="C", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", peripheries=1, penwidth=2.4];
  D [label="D", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", peripheries=1, penwidth=2.4];
  E [label="E", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  F [label="F", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", peripheries=1, penwidth=2.4];
  G [label="G", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", peripheries=1, penwidth=2.4];
  H [label="H", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", peripheries=1, penwidth=2.4];
  I [label="I", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", peripheries=1, penwidth=2.4];
  J [label="J", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", peripheries=1, penwidth=2.4];
  K [label="K\n(TARGET)", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", peripheries=2, penwidth=3.2, fontsize=11, width=0.85, height=0.85];
  L [label="L", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  M [label="M", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#334155", peripheries=1, penwidth=2.4];
  N [label="N", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", peripheries=1, penwidth=2.4];
  O [label="O", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#1E3A8A", peripheries=1, penwidth=2.4];
  A -- B [color="#7C3AED", penwidth=3.8];
  A -- D [color="#7C3AED", penwidth=3.8];
  A -- J [color="#7C3AED", penwidth=3.8];
  B -- C [color="#7C3AED", penwidth=3.8];
  B -- D;
  B -- K [color="#7C3AED", penwidth=3.8];
  B -- N [color="#7C3AED", penwidth=3.8];
  C -- D;
  C -- F [color="#7C3AED", penwidth=3.8];
  C -- G [color="#7C3AED", penwidth=3.8];
  C -- H [color="#7C3AED", penwidth=3.8];
  C -- J;
  C -- K;
  C -- O [color="#7C3AED", penwidth=3.8];
  D -- E;
  D -- G;
  D -- I;
  D -- K;
  E -- J;
  E -- M;
  E -- N;
  F -- I [color="#7C3AED", penwidth=3.8];
  F -- J;
  F -- K;
  G -- H;
  G -- J;
  G -- K;
  G -- O;
  H -- L;
  H -- O;
  I -- J;
  I -- N;
  K -- N;
  K -- O;
  L -- M;
  status [shape=plain, fixedsize=false, width=0, height=0, margin=0, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="7" BGCOLOR="#F1F5F9">
      <TR><TD ALIGN="LEFT"><B>Stack (top at right):</B> J  |  D  |  N  |  K  |  O  |  H  |  G</TD></TR>
      <TR><TD ALIGN="LEFT"><B>Visited:</B> A, B, C, F, I</TD></TR>
    </TABLE>
  >];
}
